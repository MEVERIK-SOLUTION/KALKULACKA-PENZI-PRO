# Frontend & API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Authentication (budoucí implementace)
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id
VITE_APPLE_SERVICE_ID=your-apple-service-id
VITE_SEZNAM_CLIENT_ID=your-seznam-client-id

# Backend Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_LOG_LEVEL=INFO

# Database (budoucí - D1/Railway)
DATABASE_URL=sqlite:///./pension_calculator.db
# Pro produkci: DATABASE_URL=postgresql://user:pass@railway-host/dbname

# Public APIs
MAPBOX_TOKEN=your-mapbox-token
CZECHOPEN_DATA_API_KEY=your-czech-open-data-key

# NVIDIA NIM (pokud bude aktivní)
# NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com

# Cloudflare Workers & D1
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_DATABASE_ID=your-d1-database-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Railway
RAILWAY_TOKEN=your-railway-token
RAILWAY_PROJECT_ID=your-railway-project-id

# GitHub
GITHUB_TOKEN=your-github-personal-access-token
GitHub_username=MEVERIK-SOLUTION

# Security
API_KEYS=your-api-key-1,your-api-key-2
API_KEY=your-single-api-key  # Alternative: single key instead of comma-separated

# Rate Limiting
RATE_LIMIT_DEFAULT=200/minute

# HTTPS (lokální vývoj - cesty k certifikátům)
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Development
DEBUG=False
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Production (Azure Container Apps)
# AZURE_RESOURCE_GROUP=pension-api-rg
# AZURE_LOCATION=westeurope
# AZURE_ENV=pension-api-env
# AZURE_APP=pension-api
# AZURE_REGISTRY=pensionapiregistry

# Ngrok
# NGROK_AUTH_TOKEN=your-ngrok-auth-token
# NGROK_DOMAIN=your-domain.ngrok-free.app
# NGROK_REGION=eu

# Cloudflare Tunnel
# CF_TUNNEL_NAME=pension-api
# CF_TUNNEL_DOMAIN=api.priklad.cz